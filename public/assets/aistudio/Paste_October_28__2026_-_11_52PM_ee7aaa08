<!DOCTYPE html>
<html lang="tr" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>SE Primer — 08:00, Randevu Sistemi Çöktü</title>
  
  <!-- Inter Font & Material Symbols -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            appBg: 'var(--app-bg)',
            appSurface: 'var(--app-surface)',
            appSurfaceHigh: 'var(--app-surface-high)',
            appBorder: 'var(--app-border)',
            appText: 'var(--app-text)',
            appMuted: 'var(--app-muted)',
            appYellow: 'var(--app-yellow)',
            appMint: '#4ADE9A',
            appMercan: '#FF6B5B'
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif']
          },
          boxShadow: {
            'glow-yellow': '0 0 25px -2px rgba(255, 230, 0, 0.55)',
            'glow-mint': '0 0 20px -3px rgba(74, 222, 154, 0.45)',
            'glow-mercan': '0 0 20px -3px rgba(255, 107, 91, 0.45)'
          }
        }
      }
    };
  </script>

  <style>
    /* ======================================================== */
    /* RENK PALETİ & TEMA DEĞİŞKENLERİ                          */
    /* ======================================================== */
    :root {
      /* GECE MODU (VARSAYILAN): Lacivert zemin + Canlı Açık Sarı Butonlar */
      --body-outer-bg: #071129;
      --app-bg: #0B1B3F;
      --app-surface: #14285A;
      --app-surface-high: #1E3574;
      --app-border: #2A3F73;
      --app-text: #FFFFFF;
      --app-muted: #A9B6D3;
      --app-yellow: #FFE600; /* Çok canlı, açık, parlak sarı */
      --app-yellow-hover: #FFF170;
      --app-yellow-glow: rgba(255, 230, 0, 0.5);

      /* Buton Stilleri */
      --btn-main-bg: #FFE600;
      --btn-main-text: #0B1B3F;
      --choice-btn-bg: #14285A;
      --choice-btn-text: #FFFFFF;
      --choice-border: #2A3F73;
      --header-bg: rgba(20, 40, 90, 0.6);
      --card-bg-subtle: rgba(11, 27, 63, 0.7);
    }

    body.theme-light {
      /* GÜNDÜZ MODU: Açık Sarı Arka Plan + Lacivert Butonlar & Kartlar */
      --body-outer-bg: #F5E6A3;
      --app-bg: #FFF8CC; /* Açık ve aydınlık canlı sarı zemin */
      --app-surface: #FFF0A3; /* Tatlı açık sarı kart yüzeyi */
      --app-surface-high: #FFE77D;
      --app-border: #E8D066;
      --app-text: #0B1B3F; /* Gündüz metinleri lacivert buton rengiyle aynı */
      --app-muted: #43547A; /* Koyu lacivert ara metinler */
      --app-yellow: #0B1B3F; /* Gündüz modunda vurgu lacivert */
      --app-yellow-hover: #14285A;
      --app-yellow-glow: rgba(11, 27, 63, 0.25);

      /* Butonlar: Lacivert zemin + Canlı Sarı yazı */
      --btn-main-bg: #0B1B3F;
      --btn-main-text: #FFE600;
      --choice-btn-bg: #0B1B3F;
      --choice-btn-text: #FFFFFF;
      --choice-border: #0B1B3F;
      --header-bg: rgba(255, 240, 163, 0.8);
      --card-bg-subtle: rgba(255, 255, 255, 0.5);
    }

    body.theme-light [class~="text-[#FFE600]"] {
      color: var(--app-yellow);
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    body {
      background-color: var(--body-outer-bg);
      color: var(--app-text);
      font-family: 'Inter', system-ui, sans-serif;
      min-height: 100dvh;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    .pb-safe { padding-bottom: max(1.2rem, env(safe-area-inset-bottom)); }
    .pt-safe { padding-top: max(1rem, env(safe-area-inset-top)); }
    
    .screen-fade {
      animation: slideUpFade 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes slideUpFade {
      from { opacity: 0; transform: translateY(10px) scale(0.99); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* Ana Aksiyon Butonu */
    .app-main-btn {
      background-color: var(--btn-main-bg);
      color: var(--btn-main-text);
      box-shadow: 0 4px 14px var(--app-yellow-glow);
    }
    .app-main-btn:hover {
      filter: brightness(1.08);
    }

    /* Seçenek Kart Butonu */
    .app-choice-card {
      background-color: var(--choice-btn-bg);
      color: var(--choice-btn-text);
      border: 1.5px solid var(--choice-border);
    }

    .btn-profile-opt {
      color: var(--app-text);
    }
    
    /* Nabız Hattı Animasyonu */
    .ekg-line {
      stroke-dasharray: 200;
      stroke-dashoffset: 200;
      animation: ekgPulse 2.4s linear infinite;
    }
    @keyframes ekgPulse {
      0% { stroke-dashoffset: 200; }
      100% { stroke-dashoffset: -200; }
    }

    /* Nokta Animasyonu */
    .dot-flashing {
      display: inline-block;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background-color: #FFE600;
      animation: dotPulse 0.8s infinite alternate;
    }
    .dot-flashing:nth-child(2) { animation-delay: 0.2s; }
    .dot-flashing:nth-child(3) { animation-delay: 0.4s; }
    @keyframes dotPulse {
      0% { opacity: 0.2; transform: scale(0.7); }
      100% { opacity: 1; transform: scale(1.3); }
    }

    /* Konfeti Canvas */
    #confetti-canvas {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 99;
    }
  </style>
</head>
<body class="flex justify-center min-h-screen">

  <canvas id="confetti-canvas"></canvas>

  <!-- Mobile Shell Container (390×844 tabanlı responsive) -->
  <main class="w-full max-w-[420px] min-h-screen bg-appBg flex flex-col relative px-4 pt-safe pb-safe shadow-2xl border-x border-appBorder">

    <!-- TOP HEADER: KONTROLLER & GECE/GÜNDÜZ MODU -->
    <header data-cy="app-header" class="flex items-center justify-between py-2 px-2 border-b border-appBorder mb-3 rounded-xl backdrop-blur-md" style="background-color: var(--header-bg);">
      <div class="flex items-center gap-2">
        <div class="relative flex items-center justify-center">
          <span class="w-2.5 h-2.5 rounded-full bg-[#FFE600] animate-ping absolute opacity-75"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#FFE600] relative"></span>
        </div>
        <div class="flex flex-col">
          <span class="text-[11px] font-black tracking-widest uppercase text-appText flex items-center gap-1">
            SE PRIMER <span class="text-[#FFE600] drop-shadow-sm font-extrabold">· 08:00</span>
          </span>
          <span class="text-[9px] text-appMuted flex items-center gap-1 font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-appMint"></span> Kriz Odası
          </span>
        </div>
      </div>
      
      <!-- Hızlı Kontroller: Tema (Gece/Gündüz) + Ses + API -->
      <div class="flex items-center gap-1.5">
        <!-- Gece / Gündüz Modu Butonu (data-cy="theme-toggle-btn") -->
        <button id="themeToggleBtn" data-cy="theme-toggle-btn" onclick="toggleTheme()" title="Gece / Gündüz Modu" class="p-1.5 rounded-lg bg-appSurface text-[#FFE600] border border-appBorder hover:bg-appSurfaceHigh transition-all active:scale-95 flex items-center justify-center">
          <span class="material-symbols-outlined text-[18px]" id="themeIcon">light_mode</span>
        </button>

        <!-- Ses Aç/Kapat Butonu (data-cy="audio-toggle-btn") -->
        <button id="soundToggleBtn" data-cy="audio-toggle-btn" onclick="toggleSound()" title="Sesi Aç/Kapat" class="p-1.5 rounded-lg bg-appSurface text-[#FFE600] border border-appBorder hover:bg-appSurfaceHigh transition-all active:scale-95 flex items-center justify-center">
          <span class="material-symbols-outlined text-[18px]" id="soundIcon">volume_up</span>
        </button>

        <!-- Gemini API Butonu (data-cy="api-key-toggle-btn") -->
        <button id="apiKeyToggleBtn" data-cy="api-key-toggle-btn" onclick="toggleApiKeyModal()" class="text-[11px] text-appMuted hover:text-appText flex items-center gap-1 bg-appSurface px-2 py-1.5 rounded-lg border border-appBorder active:scale-95 transition-all">
          <span class="material-symbols-outlined text-[15px] text-[#FFE600]">key</span>
          <span id="apiKeyStatusText" data-cy="api-key-status" class="font-bold">API</span>
        </button>
      </div>
    </header>

    <!-- GEMINI API MODAL -->
    <div id="apiKeyModal" data-cy="api-key-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
      <div class="bg-appSurface border border-appBorder w-full max-w-sm rounded-2xl p-5 flex flex-col gap-3 shadow-2xl">
        <div class="flex justify-between items-center">
          <h3 class="text-sm font-black text-[#FFE600] flex items-center gap-1.5">
            <span class="material-symbols-outlined text-base">smart_toy</span> Gemini Sokratik Model
          </h3>
          <button data-cy="api-key-modal-close-btn" onclick="toggleApiKeyModal()" class="text-appMuted hover:text-appText p-1">
            <span class="material-symbols-outlined text-lg">close</span>
          </button>
        </div>
        <p class="text-xs text-appMuted leading-relaxed">
          Google Gemini API anahtarınızı girerseniz Sokratik AI Tutor canlı Gemini API'ye bağlanır. Boş bırakırsanız dahili sokratik soru motoru devrede kalır.
        </p>
        <input type="password" id="geminiApiKeyInput" data-cy="gemini-api-key-input" placeholder="AIzaSy..." class="w-full bg-appBg text-xs p-3 rounded-xl border border-appBorder text-appText focus:outline-none focus:border-[#FFE600]">
        <div class="flex gap-2 justify-end pt-2">
          <button data-cy="api-key-save-btn" onclick="saveApiKey()" class="px-4 py-2 app-main-btn font-black text-xs rounded-xl active:scale-95 transition-all">
            Kaydet & Kapat
          </button>
        </div>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- EKRAN 1: GİRİŞ (DURUM: Giris)                            -->
    <!-- ======================================================== -->
    <section id="screen-giris" data-cy="screen-giris" class="screen-fade flex flex-col flex-1 justify-between pb-2">
      <div class="flex flex-col gap-3">
        
        <!-- Hero Banner -->
        <div class="relative overflow-hidden rounded-2xl bg-appSurface border border-appBorder p-4 shadow-lg">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#FFE600]/20 border border-[#FFE600]/40 text-[#FFE600] text-[10px] font-black tracking-wider uppercase mb-2">
            <span class="material-symbols-outlined text-xs">local_hospital</span> ACİL SAĞLIK MİMARİSİ
          </div>
          <h1 class="text-2xl font-black tracking-tight text-appText leading-tight">
            08:00, Randevu Sistemi Çöktü
          </h1>
          <p class="text-xs text-appMuted mt-1 leading-relaxed">
            300 hasta kapıda, veritabanı kilit. Kriz masasında kararlarını vermeden önce profilini belirle.
          </p>

          <!-- Animasyonlu Nabız Çizgisi -->
          <div class="mt-3 pt-2.5 border-t border-appBorder flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg class="w-20 h-5" viewBox="0 0 100 24">
                <path d="M0,12 L30,12 L35,4 L40,20 L45,2 L50,18 L55,12 L100,12" fill="none" stroke="#FFE600" stroke-width="2.2" class="ekg-line"></path>
              </svg>
              <span class="text-[10px] font-mono font-bold text-[#FFE600] animate-pulse">SİSTEM_NABZI: KRİTİK</span>
            </div>
            <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-appBg border border-appBorder text-appMint">v2.4.0</span>
          </div>
        </div>

        <!-- 3 Zorunlu Soru Alanı -->
        <div class="flex flex-col gap-2.5">

          <!-- 01 Seviyen -->
          <div id="wrapper-level" data-cy="question-level-wrapper" class="p-3 rounded-xl bg-appSurface border border-appBorder transition-all">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[11px] font-black tracking-wider text-[#FFE600] uppercase flex items-center gap-1.5">
                <span class="w-4 h-4 rounded bg-appBg border border-appBorder flex items-center justify-center text-[10px] font-mono text-[#FFE600]">1</span>
                Seviyen?
              </span>
              <span id="badge-level" data-cy="badge-level" class="text-[10px] text-appMuted font-mono">Zorunlu</span>
            </div>
            <div class="grid grid-cols-2 gap-2" role="radiogroup">
              <button type="button" data-cy="level-beginner" onclick="selectProfile('level', 'beginner', this)" class="btn-profile-opt min-h-[46px] px-3 py-2 rounded-xl border border-appBorder bg-appBg text-left text-xs font-bold flex items-center justify-between transition-all active:scale-[0.98]">
                <span>Yeni başladım</span>
                <span class="material-symbols-outlined text-sm opacity-40">radio_button_unchecked</span>
              </button>
              <button type="button" data-cy="level-experienced" onclick="selectProfile('level', 'experienced', this)" class="btn-profile-opt min-h-[46px] px-3 py-2 rounded-xl border border-appBorder bg-appBg text-left text-xs font-bold flex items-center justify-between transition-all active:scale-[0.98]">
                <span>Deneyimliyim</span>
                <span class="material-symbols-outlined text-sm opacity-40">radio_button_unchecked</span>
              </button>
            </div>
            <p id="error-level" data-cy="error-level" class="text-[11px] text-appMercan mt-1.5 hidden flex items-center gap-1 font-semibold">
              <span class="material-symbols-outlined text-xs">warning</span> Lütfen deneyim seviyeni belirle.
            </p>
          </div>

          <!-- 02 Rolün -->
          <div id="wrapper-role" data-cy="question-role-wrapper" class="p-3 rounded-xl bg-appSurface border border-appBorder transition-all">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[11px] font-black tracking-wider text-[#FFE600] uppercase flex items-center gap-1.5">
                <span class="w-4 h-4 rounded bg-appBg border border-appBorder flex items-center justify-center text-[10px] font-mono text-[#FFE600]">2</span>
                Rolün?
              </span>
              <span id="badge-role" data-cy="badge-role" class="text-[10px] text-appMuted font-mono">Zorunlu</span>
            </div>
            <div class="grid grid-cols-3 gap-2" role="radiogroup">
              <button type="button" data-cy="role-dev" onclick="selectProfile('role', 'dev', this)" class="btn-profile-opt min-h-[46px] p-2 rounded-xl border border-appBorder bg-appBg text-center text-xs font-bold flex flex-col items-center justify-center gap-0.5 transition-all active:scale-[0.98]">
                <span class="material-symbols-outlined text-sm text-[#FFE600]">code</span>
                <span class="text-[11px]">Geliştirici</span>
              </button>
              <button type="button" data-cy="role-qa" onclick="selectProfile('role', 'qa', this)" class="btn-profile-opt min-h-[46px] p-2 rounded-xl border border-appBorder bg-appBg text-center text-xs font-bold flex flex-col items-center justify-center gap-0.5 transition-all active:scale-[0.98]">
                <span class="material-symbols-outlined text-sm text-appMint">bug_report</span>
                <span class="text-[11px]">Testçi (QA)</span>
              </button>
              <button type="button" data-cy="role-manager" onclick="selectProfile('role', 'manager', this)" class="btn-profile-opt min-h-[46px] p-2 rounded-xl border border-appBorder bg-appBg text-center text-xs font-bold flex flex-col items-center justify-center gap-0.5 transition-all active:scale-[0.98]">
                <span class="material-symbols-outlined text-sm text-[#FFE600]">account_tree</span>
                <span class="text-[11px]">Yönetici</span>
              </button>
            </div>
            <p id="error-role" data-cy="error-role" class="text-[11px] text-appMercan mt-1.5 hidden flex items-center gap-1 font-semibold">
              <span class="material-symbols-outlined text-xs">warning</span> Lütfen nöbetteki rolünü seç.
            </p>
          </div>

          <!-- 03 Hedefin -->
          <div id="wrapper-goal" data-cy="question-goal-wrapper" class="p-3 rounded-xl bg-appSurface border border-appBorder transition-all">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[11px] font-black tracking-wider text-[#FFE600] uppercase flex items-center gap-1.5">
                <span class="w-4 h-4 rounded bg-appBg border border-appBorder flex items-center justify-center text-[10px] font-mono text-[#FFE600]">3</span>
                Hedefin?
              </span>
              <span id="badge-goal" data-cy="badge-goal" class="text-[10px] text-appMuted font-mono">Zorunlu</span>
            </div>
            <div class="grid grid-cols-3 gap-2" role="radiogroup">
              <button type="button" data-cy="goal-exam" onclick="selectProfile('goal', 'exam', this)" class="btn-profile-opt min-h-[46px] p-2 rounded-xl border border-appBorder bg-appBg text-center text-xs font-bold flex flex-col items-center justify-center gap-0.5 transition-all active:scale-[0.98]">
                <span class="material-symbols-outlined text-sm text-appMuted">school</span>
                <span class="text-[11px]">Sınav</span>
              </button>
              <button type="button" data-cy="goal-career" onclick="selectProfile('goal', 'career', this)" class="btn-profile-opt min-h-[46px] p-2 rounded-xl border border-appBorder bg-appBg text-center text-xs font-bold flex flex-col items-center justify-center gap-0.5 transition-all active:scale-[0.98]">
                <span class="material-symbols-outlined text-sm text-appMuted">trending_up</span>
                <span class="text-[11px]">Kariyer</span>
              </button>
              <button type="button" data-cy="goal-curiosity" onclick="selectProfile('goal', 'curiosity', this)" class="btn-profile-opt min-h-[46px] p-2 rounded-xl border border-appBorder bg-appBg text-center text-xs font-bold flex flex-col items-center justify-center gap-0.5 transition-all active:scale-[0.98]">
                <span class="material-symbols-outlined text-sm text-appMuted">lightbulb</span>
                <span class="text-[11px]">Merak</span>
              </button>
            </div>
            <p id="error-goal" data-cy="error-goal" class="text-[11px] text-appMercan mt-1.5 hidden flex items-center gap-1 font-semibold">
              <span class="material-symbols-outlined text-xs">warning</span> Lütfen hedefini belirle.
            </p>
          </div>

        </div>
      </div>

      <!-- Başla Butonu (data-cy="start") -->
      <div class="mt-4 pt-1">
        <button type="button" id="startBtn" data-cy="start" onclick="handleStartGame()" class="w-full min-h-[52px] app-main-btn font-black text-sm rounded-xl flex items-center justify-center gap-2 active:scale-[0.98] transition-all shadow-lg">
          <span>Kriz Odasına Giriş Yap</span>
          <span class="material-symbols-outlined text-lg">bolt</span>
        </button>
      </div>
    </section>

    <!-- ======================================================== -->
    <!-- EKRAN 2: KRİZ BRİFİNGİ (DURUM: Kriz)                     -->
    <!-- ======================================================== -->
    <section id="screen-kriz" data-cy="screen-kriz" class="screen-fade hidden flex flex-col flex-1 justify-between pb-2">
      <div class="flex flex-col gap-3.5">
        
        <!-- P0 Kriz Bandı -->
        <div class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-appMercan/20 border border-appMercan/50 text-appMercan shadow-glow-mercan">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-appMercan animate-ping"></span>
            <span class="text-xs font-black tracking-wider uppercase">ACİL MÜDAHALE · P0 ÇÖKÜŞ</span>
          </div>
          <span class="text-[11px] font-mono font-bold">08:00 TSİ</span>
        </div>

        <!-- Brifing Kartı -->
        <div class="bg-appSurface border border-appBorder rounded-2xl p-4 flex flex-col gap-3 shadow-xl">
          <div class="flex items-center justify-between border-b border-appBorder pb-2">
            <span class="text-xs font-black text-[#FFE600] flex items-center gap-1">
              <span class="material-symbols-outlined text-sm">domain</span> Şehir Hastanesi Bilgi İşlem
            </span>
            <span class="text-[10px] font-mono text-appMuted bg-appBg px-2 py-0.5 rounded border border-appBorder">INC-9102</span>
          </div>

          <h2 class="text-base font-extrabold text-appText leading-snug">
            "Randevu servisi HTTP 503 veriyor. Kapıda 300 hasta onay bekliyor!"
          </h2>

          <p id="kriz-personalized-text" data-cy="kriz-briefing-text" class="text-xs text-appMuted leading-relaxed">
            Dün gece v2.4.0 dağıtımı canlıya alındı. Saat tam 08:00'de poliklinik bankoları açıldığı an veritabanı bağlantı havuzu (connection pool) tükendi. Nöbetçi mühendis sensin.
          </p>

          <div class="grid grid-cols-2 gap-2 mt-1">
            <div class="bg-appBg p-2.5 rounded-xl border border-appBorder flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-appMercan/15 text-appMercan flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-base">group</span>
              </div>
              <div class="flex flex-col">
                <span class="text-[10px] text-appMuted">Kuyruk</span>
                <span class="text-xs font-black text-appText">300+ Hasta</span>
              </div>
            </div>
            <div class="bg-appBg p-2.5 rounded-xl border border-appBorder flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-[#FFE600]/20 text-[#FFE600] flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-base">timer</span>
              </div>
              <div class="flex flex-col">
                <span class="text-[10px] text-appMuted">SLA Limiti</span>
                <span class="text-xs font-black text-[#FFE600]">&lt; 15 Dakika</span>
              </div>
            </div>
          </div>
