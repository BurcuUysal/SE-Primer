  <!-- SCRIPT MOTORU & TEMA & SES                               -->
  <!-- ======================================================== -->
  <script>
    const SYSTEM_PROMPT = "You are a Socratic tutor. Never say which option is correct. Never write 'choose A' or 'choose B'. Ask exactly one guiding question per reply. If the player insists on the answer, politely refuse and ask a simpler question. Never ask for real personal data.";

    // ----------------------------------------------------
    // GECE / GÜNDÜZ MODU YÖNETİMİ
    // ----------------------------------------------------
    let currentTheme = localStorage.getItem('app_theme') || 'dark';

    function initTheme() {
      applyTheme(currentTheme);
    }

    function toggleTheme() {
      playSfx('click');
      currentTheme = (currentTheme === 'dark') ? 'light' : 'dark';
      localStorage.setItem('app_theme', currentTheme);
      applyTheme(currentTheme);
    }

    function applyTheme(theme) {
      const themeIcon = document.getElementById('themeIcon');
      if (theme === 'light') {
        document.body.classList.add('theme-light');
        document.documentElement.classList.remove('dark');
        themeIcon.textContent = 'dark_mode';
        themeIcon.title = 'Gece Moduna Geç';
      } else {
        document.body.classList.remove('theme-light');
        document.documentElement.classList.add('dark');
        themeIcon.textContent = 'light_mode';
        themeIcon.title = 'Gündüz Moduna Geç';
      }
    }

    // ----------------------------------------------------
    // WEB AUDIO API SES MOTORU
    // ----------------------------------------------------
    let audioCtx = null;
    let soundEnabled = true;

    function initAudio() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function toggleSound() {
      soundEnabled = !soundEnabled;
      const icon = document.getElementById('soundIcon');
      if (soundEnabled) {
        icon.textContent = 'volume_up';
        icon.classList.remove('opacity-40');
        playTone(520, 'sine', 0.1);
      } else {
        icon.textContent = 'volume_off';
        icon.classList.add('opacity-40');
      }
    }

    function playTone(freq, type = 'sine', duration = 0.15, vol = 0.12) {
      if (!soundEnabled) return;
      try {
        initAudio();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(vol, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (e) {}
    }

    function playSfx(type) {
      if (!soundEnabled) return;
      if (type === 'click') {
        playTone(600, 'triangle', 0.06, 0.08);
      } else if (type === 'correct') {
        playTone(523.25, 'sine', 0.12, 0.12);
