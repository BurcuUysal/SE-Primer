    function restartSimulation() {
      playSfx('click');
      appState.profile = { level: null, role: null, goal: null };
      appState.currentDecisionIndex = 0;
      appState.answers = [];
      clearInterval(appState.timerInterval);

      document.querySelectorAll('.btn-profile-opt').forEach(b => {
        b.classList.remove('border-[#FFE600]', 'bg-[#FFE600]/15', 'shadow-glow-yellow');
        b.classList.add('border-appBorder', 'bg-appBg');
        const icon = b.querySelector('.material-symbols-outlined');
        if (icon) {
          icon.textContent = 'radio_button_unchecked';
          icon.classList.remove('text-[#FFE600]');
          icon.classList.add('opacity-40');
        }
      });

      changeState('Giris');
    }

    // ----------------------------------------------------
    // SOKRATİK AI TUTOR (GEMINI + YEREL MOTOR)
    // ----------------------------------------------------
    async function handleTutorMessage(e) {
      e.preventDefault();
      playSfx('click');
      const input = document.getElementById('tutor-input');
      const questionEl = document.getElementById('tutor-question-text');
      const indicator = document.getElementById('tutor-indicator');
      const userText = input.value.trim();

      if (!userText) return;

      input.value = '';
      input.disabled = true;
      indicator.classList.remove('hidden');

      const currentDecision = decisionsData[appState.currentDecisionIndex];

      if (appState.apiKey) {
        try {
          const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${encodeURIComponent(appState.apiKey)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [
                {
                  role: 'user',
                  parts: [
                    {
                      text: `${SYSTEM_PROMPT}\n\nMevcut Kriz Durumu: "${currentDecision.topic} - ${currentDecision.title}".\nOyuncunun Mesajı: "${userText}".\nYalnızca Türkçe olarak tek bir yönlendirici Sokratik soru sor.`
                    }
                  ]
                }
              ]
            })
          });

          const data = await response.json();
          if (data?.candidates?.[0]?.content?.parts?.[0]?.text) {
            questionEl.textContent = `"${data.candidates[0].content.parts[0].text.trim()}"`;
            indicator.classList.add('hidden');
            input.disabled = false;
            playSfx('correct');
            return;
          }
        } catch (err) {
          console.warn('Gemini API bağlantısı başarısız, yerel motor devrede:', err);
        }
      }

      setTimeout(() => {
        indicator.classList.add('hidden');
        input.disabled = false;
        questionEl.textContent = `"${generateLocalSocraticReply(userText, currentDecision.id)}"`;
        playSfx('click');
      }, 650);
    }

    function generateLocalSocraticReply(userText, decisionId) {
      const lower = userText.toLowerCase();

      if (lower.includes('cevap') || lower.includes('hangisi') || lower.includes('söyle') || lower.includes('a mı') || lower.includes('b mi')) {
        return "Doğrudan cevabı veremem; fakat seni düşündürebilirim: İki seçenek arasında geri dönülemez bir risk taşıyan hangisi?";
      }

      if (decisionId === 1) {
        if (lower.includes('şema') || lower.includes('migration') || lower.includes('db')) {
          return "Şema farkını tespit ettiğinde, geriye dönük uyumsuz bir kolon değişikliği varsa rollback öncesinde ne yapmak gerekir?";
        }
        return "Geri dönmeden önce veritabanı şemasının değişip değişmediğini nasıl anlarsın?";
      } 
      else if (decisionId === 2) {
        if (lower.includes('test') || lower.includes('vakit') || lower.includes('zaman')) {
          return "Krizde 60 saniyelik bir smoke test ile kurtarılacak prestij arasındaki ilişkiyi nasıl değerlendirirsin?";
        }
        return "Sistemi test etmeden doğrudan yayına aldığında oluşabilecek yeni bir hatayı kim fark eder?";
      } 
      else {
        if (lower.includes('kvkk') || lower.includes('hasta') || lower.includes('isim')) {
          return "Bir yazılım mühendisi hatayı çözmek için gerçek bir hastanın kimliğine mi yoksa sadece logdaki hata izine (stack trace) mi ihtiyaç duyar?";
        }
        return "Kriz esnasında hız kazanmak adına hasta mahremiyetini hiçe saymanın doğuracağı hukuki sonuçları düşündün mü?";
      }
    }

    function toggleApiKeyModal() {
      playSfx('click');
      const modal = document.getElementById('apiKeyModal');
      const input = document.getElementById('geminiApiKeyInput');
      input.value = appState.apiKey || '';
      modal.classList.toggle('hidden');
    }

    function saveApiKey() {
      playSfx('correct');
      const input = document.getElementById('geminiApiKeyInput');
      appState.apiKey = input.value.trim();
      localStorage.setItem('gemini_api_key', appState.apiKey);
      updateApiKeyStatus();
      toggleApiKeyModal();
    }

    function updateApiKeyStatus() {
      const statusText = document.getElementById('apiKeyStatusText');
      if (appState.apiKey) {
        statusText.textContent = 'Gemini';
        statusText.classList.add('text-appMint');
      } else {
        statusText.textContent = 'API';
        statusText.classList.remove('text-appMint');
      }
    }
  </script>
